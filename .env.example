# Copy to `.env` and adjust as needed. Every value is optional.

# SQLite (default - zero setup, file created on first start)
DATABASE_URL=sqlite:///./ledger.db

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger

# Log every SQL statement (debugging only)
SQL_ECHO=false

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
