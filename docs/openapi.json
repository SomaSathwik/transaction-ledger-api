{
  "openapi": "3.1.0",
  "info": {
    "title": "Transaction Ledger API",
    "description": "\nA small, strongly consistent transaction ledger.\n\n* Accounts start at a **zero** balance; the client cannot set it.\n* Credits increase and debits decrease the balance; overdrafts are rejected.\n* `reference_id` is an idempotency key that is unique per account.\n* Transactions are **immutable** and are always listed latest-first with filtering and pagination.\n* Creating a transaction and updating the balance is a single atomic database transaction.\n* Transfers debit one account and credit another atomically - no partial transfers.\n\nAll errors share one envelope: `{\"error\": {\"code\": \"...\", \"message\": \"...\", \"details\": {...}}}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Create an account",
        "description": "Creates a new account for the given holder name. The balance always starts at **0.00** and `id` / `created_at` are generated by the server. Any attempt to supply a `balance` (or any other unknown field) is rejected with a `VALIDATION_ERROR`.",
        "operationId": "create_account_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, path or query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "The request is invalid. See 'details.fields' for the individual problems.",
                    "details": {
                      "fields": [
                        {
                          "field": "body.amount",
                          "message": "Input should be greater than 0",
                          "type": "greater_than"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
