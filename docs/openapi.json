    "/accounts/{account_id}/transactions": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Add a transaction to an account",
        "description": "Posts a `credit` or `debit` transaction and updates the account balance in the **same database transaction**.\n\n* A debit that exceeds the current balance is rejected (`422 INSUFFICIENT_BALANCE`) and the balance is left untouched.\n* `reference_id` must be unique per account. Re-submitting the same `reference_id` returns `409 DUPLICATE_TRANSACTION` with the original transaction in `details.existing_transaction`; nothing new is created and the balance does not change.\n* Transactions are immutable: there is no update or delete endpoint.",
        "operationId": "add_transaction_accounts__account_id__transactions_post",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Account identifier (UUID).",
              "title": "Account Id"
            },
            "description": "Account identifier (UUID)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, path or query parameters.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "The request is invalid. See 'details.fields' for the individual problems.",
                    "details": {
                      "fields": [
                        {
                          "field": "body.amount",
                          "message": "Input should be greater than 0",
                          "type": "greater_than"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The referenced resource does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "ACCOUNT_NOT_FOUND",
                    "message": "Account 'f2c1\u2026' was not found.",
                    "details": {
                      "account_id": "f2c1\u2026"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A transaction with the same reference_id already exists for this account.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "DUPLICATE_TRANSACTION",
                    "message": "A transaction with reference_id 'INV-1' already exists for account 'f2c1\u2026'. No new transaction was created and the balance is unchanged.",
                    "details": {
                      "account_id": "f2c1\u2026",
                      "reference_id": "INV-1",
                      "existing_transaction": {
                        "id": "\u2026"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request was well-formed but violates a business rule.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INSUFFICIENT_BALANCE",
                    "message": "Insufficient balance: account 'f2c1\u2026' has 100.00 but 150.00 was requested. The transaction was rejected and the balance is unchanged.",
                    "details": {
                      "account_id": "f2c1\u2026",
                      "balance": "100.00",
                      "requested_amount": "150.00"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get transaction history",
        "description": "Returns the account's transactions in **latest-first** order (by `created_at`).\n\n* Filter with `type=credit` or `type=debit`; omit it to get both.\n* Paginate with `page` (1-based) and `limit`. The `pagination` object tells the client the current page, page size, total records and total pages.",
        "operationId": "list_transactions_accounts__account_id__transactions_get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Account identifier (UUID).",
              "title": "Account Id"
            },
            "description": "Account identifier (UUID)."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TransactionType"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by transaction type. Omit to return both credits and debits.",
              "title": "Type"
            },
            "description": "Filter by transaction type. Omit to return both credits and debits."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based).",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Page size (1-100). Defaults to 20.",
              "title": "Limit"
            },
            "description": "Page size (1-100). Defaults to 20."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, path or query parameters.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "The request is invalid. See 'details.fields' for the individual problems.",
                    "details": {
                      "fields": [
                        {
                          "field": "body.amount",
                          "message": "Input should be greater than 0",
                          "type": "greater_than"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The referenced resource does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "ACCOUNT_NOT_FOUND",
                    "message": "Account 'f2c1\u2026' was not found.",
                    "details": {
                      "account_id": "f2c1\u2026"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
