    "/transfers": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Transfer money between two accounts",
        "description": "Debits `from_account_id` and credits `to_account_id` for the same amount in **one atomic database transaction**. Two immutable transactions (one `debit`, one `credit`) are recorded and linked through `transfer_id`.\n\n* Both accounts must exist (`404 ACCOUNT_NOT_FOUND`).\n* The source must have sufficient balance (`422 INSUFFICIENT_BALANCE`).\n* Source and destination must differ (`422 SAME_ACCOUNT_TRANSFER`).\n* If anything fails, the whole transfer is rolled back - a partial transfer is impossible.\n* An optional `reference_id` makes the transfer idempotent per account (`409 DUPLICATE_TRANSACTION`).",
        "operationId": "create_transfer_transfers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, path or query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
